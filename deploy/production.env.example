# Example only. Replace all required blanks using server-side secrets.
# Spring Boot does not automatically read this file: inject it with your
# process manager or Docker --env-file. Never copy it into frontend/public.
# Defaults assume services on one host; use service DNS names in containers.
SERVER_ADDRESS=127.0.0.1
DB_URL=jdbc:mysql://127.0.0.1:3306/nowl?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=hue
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
ROCKETMQ_PRODUCER_GROUP=hue-producer
ES_HOST=127.0.0.1:9200
ES_USERNAME=
ES_PASSWORD=

# Required: a unique Base64-encoded secret (at least 32 random bytes).
JWT_SECRET=
UM_BACKEND_URI=http://127.0.0.1:8080
UM_BACKEND_WS_URI=ws://127.0.0.1:8080
TRUSTED_PROXY_IPS=127.0.0.1,::1
SECURITY_TRUSTED_PROXY_IPS=127.0.0.1,::1

# These values must use the same public HTTPS origin, without a trailing slash.
SECURITY_CORS_ALLOWED_ORIGIN_PATTERNS=https://campus.example.edu
SECURITY_CSRF_ALLOWED_ORIGINS=https://campus.example.edu
UM_CORS_ALLOWED_ORIGIN_PATTERN_1=https://campus.example.edu
UM_CORS_ALLOWED_ORIGIN_PATTERN_2=https://campus.example.edu

# Required for the current image upload implementation.
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET_NAME=
COS_BASE_URL=https://images.example.edu

# Keep disabled until the real SMS provider URL is configured.
SMS_ENABLED=false
SMS_SPUG_URL=

# Optional automatic moderation; otherwise plan for manual review.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.moonshot.cn
# OPENAI_MODEL=your-supported-vision-model

# Configure if using XXL-JOB jobs; built-in refund/confirmation schedules
# do not require an external XXL-JOB admin server.
XXL_JOB_ADMIN_ADDRESSES=
XXL_JOB_ACCESS_TOKEN=
XXL_EXECUTOR_APPNAME=hue-executor
XXL_EXECUTOR_PORT=9999
